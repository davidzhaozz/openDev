{
  "name": "opendev-ide",
  "version": "0.7.19",
  "description": "AI-first JavaScript / TypeScript / Java / C# IDE with embedded browser, SQL client, and Claude integration.",
  "main": "out/main/index.js",
  "author": {
    "name": "David Zhao",
    "email": "zhao@situfamily.com",
    "url": "https://davidzhao.net"
  },
  "homepage": "https://davidzhao.net",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "postinstall": "node scripts/fix-native-perms.mjs",
    "predist": "node scripts/bump-version.mjs",
    "dist": "electron-vite build && electron-builder --mac --config electron-builder.yml",
    "dist:dir": "electron-vite build && electron-builder --mac --dir --config electron-builder.yml",
    "dist:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "start": "electron-vite preview",
    "web": "npm run web:build && node out-web/server/index.mjs --open",
    "web:build": "vite build --config vite.server.config.ts && vite build --config vite.web.config.ts",
    "web:server": "node out-web/server/index.mjs",
    "web:dev": "vite --config vite.web.config.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@codemirror/autocomplete": "^6.18.1",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/language": "^6.10.3",
    "@codemirror/legacy-modes": "^6.4.1",
    "@codemirror/lint": "^6.8.2",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@vscode/ripgrep": "^1.15.9",
    "chokidar": "^4.0.1",
    "fuzzysort": "^3.1.0",
    "keytar": "^7.9.0",
    "mysql2": "^3.11.4",
    "node-pty": "^1.0.0",
    "openai": "^6.37.0",
    "pg": "^8.13.1",
    "prettier": "^3.3.3",
    "pyright": "^1.1.409",
    "react": "^18.3.1",
    "react-arborist": "^3.4.0",
    "react-dom": "^18.3.1",
    "simple-git": "^3.27.0",
    "typescript": "^5.6.3",
    "typescript-language-server": "^4.3.3",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "ws": "^8.18.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.11"
  }
}
